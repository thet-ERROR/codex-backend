# Copy to .env for local development. On Render these live in Environment, not in a file.
# .env itself is gitignored — never commit real values.
#
# Every name below is read by server.js. The three marked REQUIRED fail closed: without them the
# server still boots and serves the public catalogue, but logs a loud error and refuses the routes
# that depend on them, rather than falling back to an insecure default.

# --- REQUIRED ---

# MongoDB Atlas connection string.
DB_URI=mongodb+srv://user:password@cluster.mongodb.net/codex

# Signs every user and admin JWT. No fallback exists on purpose: a hardcoded default would let
# anyone mint valid tokens. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# The admin panel password, exchanged once at /api/login for an 8h scoped token.
ADMIN_PASSWORD=

# --- CORS ---
# Comma-separated list of allowed browser origins. Scheme + host, no trailing slash, no path.
# Unset means every browser request is refused — it fails closed rather than opening the API to
# every site. The first entry is also the base for verification links sent by email.
FRONTEND_URL=https://codex-iota-nine.vercel.app

# --- EMAIL (Mailjet Send API v3.1) ---
# HTTP, not SMTP: Render's free tier blocks outbound ports 25/465/587 since Sept 2025, so
# nodemailer over Gmail could never connect from there. Without these, account verification and
# password reset emails silently fail — the account is still created, the mail just never arrives.
MAILJET_API_KEY=
MAILJET_SECRET_KEY=

# Sender address. Must be a validated sender in Mailjet or every send is rejected.
EMAIL_FROM=noreply@yourdomain.com
EMAIL_FROM_NAME=CODEX SYSTEMS

# --- OPTIONAL ---
# Render sets PORT itself; this is only for local runs.
PORT=5000

# Set to "production" on the host. The global error handler already returns a generic 500
# regardless, so a stack trace never reaches a client either way — but Express's own defaults
# are safer with it set.
NODE_ENV=development
